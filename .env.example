# =====================================================================
# Baywoods Store - Next.js environment variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to git.
# =====================================================================

# ----- Supabase -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- Google sign-in -------------------------------------------------
# Leave false until the Supabase Dashboard → Authentication → Providers → Google
# has a valid Client ID + secret (and the Google Cloud OAuth client lists
# https://<project-ref>.supabase.co/auth/v1/callback as an authorized redirect).
# While false, the "Continue with Google" button is hidden so users don't hit
# Google's invalid_client (401) error.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ----- Site URL -------------------------------------------------------
# Used in email CTAs, public metadata, and Open Graph. Must be the full URL with
# no trailing slash. Production value: https://baywoods.co.ke
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- M-Pesa Daraja (direct Safaricom API) ----------------------------
# Get these from https://developer.safaricom.co.ke → My Apps
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Business ShortCode used to generate the STK password (must match your Daraja app)
MPESA_SHORTCODE=
# Lipa Na M-Pesa Online passkey from the Daraja portal
MPESA_PASSKEY=
# Public HTTPS URL Safaricom will POST STK callbacks to
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/mpesa/callback
# "sandbox" during testing, "production" when live
MPESA_ENVIRONMENT=sandbox
# Set to "true" in local dev to skip the real Daraja STK push call entirely
MPESA_MOCK=true

# Manual M-Pesa fallback while Daraja credentials are being activated.
# When "true", checkout shows a Buy Goods Till and the customer pastes their
# confirmation code; the order is saved PENDING_PAYMENT and an admin confirms
# it from /admin/payments. Set to "false" to reactivate STK push.
NEXT_PUBLIC_MPESA_MANUAL=true
# Buy Goods Till number shown at checkout in manual mode
NEXT_PUBLIC_MPESA_TILL=5386846

# ----- Email (Resend - https://resend.com) ----------------------------
RESEND_API_KEY=re_...
RESEND_AUDIENCE_ID=your-resend-audience-id

# ----- Twilio WhatsApp (order + shipping notifications) ---------------
# Create a free account at https://twilio.com; enable the WhatsApp sandbox
# under Messaging > Try it out > Send a WhatsApp message.
# For production, request a WhatsApp-approved sender number from Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox default: whatsapp:+14155238886
# Production:      whatsapp:+<your-approved-number>
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ----- Cloudinary (image uploads) ------------------------------------
CLOUDINARY_CLOUD_NAME=
# Public cloud name used by next-cloudinary on the client (<CldImage> etc.)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- Admin ----------------------------------------------------------
# Email address that receives new order notifications
ADMIN_NOTIFICATION_EMAIL=your@email.com
# A long random string - used as the admin session cookie value
ADMIN_SECRET_TOKEN=change-me-to-a-long-random-string
# Password shown at /admin/login
ADMIN_PASSWORD=change-me

# Long random secret for signed guest order links
ORDER_TOKEN_SECRET=change-me-to-a-long-random-string

# ----- Rate limiting (Upstash Redis) ----------------------------------
# When set, the API rate limiter uses a Redis-backed sliding window that
# persists across serverless instances (required in production on Vercel).
# Leave blank for local dev - the in-memory fallback is used automatically.
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- Cron -----------------------------------------------------------
# Must match the Authorization header sent by Vercel Cron
CRON_SECRET=change-me-to-a-long-random-string

# ----- Sentry (optional) ----------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ----- Anthropic (AI chat widget) -----------------------------------
ANTHROPIC_API_KEY=

# ----- Web Push (VAPID) ----------------------------------------------
# Generate once with: npx web-push generate-vapid-keys
# Set VAPID_SUBJECT to a mailto: or HTTPS URL for browser push identity.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@baywoodsstore.com
