# =====================================================================
# Baywoods Store — Next.js environment variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to git.
# =====================================================================

# ----- Supabase -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- Site URL -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Stripe ---------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ----- M-Pesa Daraja (Safaricom) --------------------------------------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=5234789
MPESA_PASSKEY=
# Public HTTPS URL that Safaricom can reach (use ngrok in dev)
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/mpesa/callback

# ----- Email (Resend — https://resend.com) ----------------------------
RESEND_API_KEY=re_...
RESEND_AUDIENCE_ID=your-resend-audience-id

# ----- Africa's Talking (SMS) -----------------------------------------
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=BAYWOODS

# ----- Cloudinary (image uploads) ------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- Admin ----------------------------------------------------------
# Email address that receives new order notifications
ADMIN_NOTIFICATION_EMAIL=your@email.com
# A long random string — used as the admin session cookie value
ADMIN_SECRET_TOKEN=change-me-to-a-long-random-string
# Password shown at /admin/login
ADMIN_PASSWORD=change-me

# ----- Cron -----------------------------------------------------------
# Must match the Authorization header sent by Vercel Cron
CRON_SECRET=change-me-to-a-long-random-string

# ----- Sentry (optional) ----------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ----- Anthropic (AI chat widget) -----------------------------------
ANTHROPIC_API_KEY=
