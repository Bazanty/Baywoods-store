# =====================================================================
# Baywoods Store — Next.js environment variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to git.
# =====================================================================

# ----- Supabase -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- Site URL -------------------------------------------------------
# Used in email CTAs, public metadata, and Open Graph. Must be the full URL with
# no trailing slash. Production value: https://baywoods.co.ke
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- M-Pesa Daraja (Safaricom) --------------------------------------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=5234789
MPESA_PASSKEY=
# Public HTTPS URL that Safaricom can reach (use ngrok in dev)
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/mpesa/callback
# Set to "production" on Vercel. Leave unset (or "sandbox") for local dev.
MPESA_ENVIRONMENT=sandbox
# Set to "true" in local dev to skip the real Daraja STK push call entirely.
MPESA_MOCK=true
# Set to "true" in local dev — Safaricom callback IPs are not reachable locally.
MPESA_SKIP_IP_CHECK=true

# ----- M-Pesa Reversal (admin auto-refund) ---------------------------
# Operator user from the Daraja portal with TransactionReversal privilege.
MPESA_INITIATOR_NAME=
# RSA-encrypted password (use Safaricom's cert; portal also generates this).
# Sandbox + production use different certs — regenerate when switching.
MPESA_SECURITY_CREDENTIAL=
# Public HTTPS URLs Safaricom POSTs the async result to.
MPESA_REVERSAL_RESULT_URL=https://your-domain.vercel.app/api/mpesa/reversal-callback
MPESA_REVERSAL_TIMEOUT_URL=https://your-domain.vercel.app/api/mpesa/reversal-callback
# "11" = Till (CustomerBuyGoods), "4" = Paybill. Defaults to "11".
MPESA_REVERSAL_RECEIVER_TYPE=11

# ----- Email (Resend — https://resend.com) ----------------------------
RESEND_API_KEY=re_...
RESEND_AUDIENCE_ID=your-resend-audience-id

# ----- Africa's Talking (SMS) -----------------------------------------
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=BAYWOODS

# ----- Cloudinary (image uploads) ------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- Admin ----------------------------------------------------------
# Email address that receives new order notifications
ADMIN_NOTIFICATION_EMAIL=your@email.com
# A long random string — used as the admin session cookie value
ADMIN_SECRET_TOKEN=change-me-to-a-long-random-string
# Password shown at /admin/login
ADMIN_PASSWORD=change-me

# Long random secret for signed guest order links
ORDER_TOKEN_SECRET=change-me-to-a-long-random-string

# ----- Rate limiting (Upstash Redis) ----------------------------------
# When set, the API rate limiter uses a Redis-backed sliding window that
# persists across serverless instances (required in production on Vercel).
# Leave blank for local dev — the in-memory fallback is used automatically.
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- Cron -----------------------------------------------------------
# Must match the Authorization header sent by Vercel Cron
CRON_SECRET=change-me-to-a-long-random-string

# ----- Sentry (optional) ----------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ----- Anthropic (AI chat widget) -----------------------------------
ANTHROPIC_API_KEY=

# ----- Web Push (VAPID) ----------------------------------------------
# Generate once with: npx web-push generate-vapid-keys
# Set VAPID_SUBJECT to a mailto: or HTTPS URL Safaricom can identify.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@baywoodsstore.com
